<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/change_size_view"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:text="改变动画view的大小"/>
        
        <Button
            android:id="@+id/change_lottie3"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintTop_toBottomOf="@+id/change_size_view"
            app:layout_constraintLeft_toLeftOf="parent"
            android:text="更改第三个动画内容"/>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_test1"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:layout_constraintTop_toBottomOf="@+id/change_lottie3"
            app:layout_constraintLeft_toLeftOf="parent"
            android:background="@color/black"
            android:scaleType="fitXY"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_speed="1"/>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_test2"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="10dp"
            android:scaleType="fitXY"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lottie_test1"
            app:lottie_rawRes="@raw/zhuti"
            android:background="@color/red"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />


        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animationView4"
            android:layout_width="200dp"
            android:layout_height="250dp"
            app:layout_constraintTop_toBottomOf="@+id/animationView3"
            app:layout_constraintLeft_toLeftOf="parent"
            android:background="@color/blue"
            app:lottie_rawRes="@raw/run"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />



        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animationView3"
            android:layout_width="200dp"
            android:layout_height="250dp"
            app:layout_constraintTop_toBottomOf="@+id/lottie_test2"
            app:layout_constraintLeft_toLeftOf="parent"
            android:background="@color/blue"
            app:lottie_fileName="grunt.json"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />


        <!--<com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animationView4"
            android:layout_width="200dp"
            android:layout_height="250dp"
            app:layout_constraintTop_toBottomOf="@+id/animationView3"
            app:layout_constraintLeft_toLeftOf="parent"
            android:background="@color/blue"
            app:lottie_rawRes="@raw/run"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />-->

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
